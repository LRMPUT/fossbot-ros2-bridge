# colcon build output. These live in the container's writable layer at runtime,
# not here, but keep them out in case anyone builds on the host.
ws/build/
ws/install/
ws/log/

# Camera stack built on the robot by build_camera_stack.sh; it is installed to
# the robot's filesystem, never checked in.
opt/

__pycache__/
*.py[cod]
*.egg-info/

*.log
.vscode/
.idea/

# Per-robot settings and calibration output: they describe one physical robot,
# not the project. The robot keeps its own agent_config.json.
robot_agent/agent_config.json
agent_config.json
motor-*.json
*-calibration.json
